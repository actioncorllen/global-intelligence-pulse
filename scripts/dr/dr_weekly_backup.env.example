# Strateloq DR weekly backup — configuration template.
# Copy to  dr_weekly_backup.env  on the WSL machine, fill in, then:  chmod 600 dr_weekly_backup.env
# NEVER commit the filled-in file. It holds secrets; .gitignore already excludes it.
# The orchestrator reads these; it never prints their values (logs are scrubbed).

# --- Supabase (READ-ONLY use: pg_dump + Storage download; no writes to production) ---
SUPABASE_DB_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"   # operator-held; secret
SUPABASE_URL="https://nxaunmyihhjixxxljcqt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"                            # secret

# --- n8n (READ-ONLY: workflow export; active/inactive/archived) ---
N8N_BASE_URL="https://tradingb.app.n8n.cloud"
N8N_API_KEY="REPLACE_ME"                                         # secret (workflow:read)

# --- Encryption: gpg recipient to encrypt every artifact to (public key id/email) ---
# The matching PRIVATE key + passphrase stay in the operator vault (needed only to RESTORE).
DR_GPG_RECIPIENT="dr@strateloq.com"

# --- Offsite destination (reuse the EXISTING verified rclone Google Drive remote) ---
# DR_REMOTE is the rclone remote:path parent under which dated backup sets are written.
# Confirm the remote name with:  rclone listremotes    (e.g. gdrive:)
DR_TRANSPORT="rclone"
DR_REMOTE="gdrive:Strateloq-DR/weekly"
# Database-only backup folder (dr_db_backup_to_drive.sh). Confirm the exact folder name.
DR_DB_REMOTE="gdrive:Strateloq-DR/Supabase Database"
# RCLONE_BIN="rclone"            # override if rclone is not on PATH under Task Scheduler

# --- Local staging + retention (bounded storage growth) ---
DR_BACKUP_ROOT="$HOME/strateloq-backups"   # local staging + run logs live here
DR_RETAIN="8"                              # keep newest 8 verified sets (local + remote)
DR_BUCKETS="pulse-generated-media"         # space-separated Supabase Storage buckets
