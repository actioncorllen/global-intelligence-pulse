# Strateloq DR weekly backup — configuration template.
# Copy to  dr_weekly_backup.env  on the WSL machine, fill in, then:  chmod 600 dr_weekly_backup.env
# NEVER commit the filled-in file. It holds secrets; .gitignore already excludes it.
# The orchestrator reads these; it never prints their values (logs are scrubbed).

# --- Supabase (READ-ONLY use: pg_dump + Storage download; no writes to production) ---
SUPABASE_DB_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"   # operator-held; secret
SUPABASE_URL="https://nxaunmyihhjixxxljcqt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"                            # secret

# --- n8n (READ-ONLY: workflow export; active/inactive/archived) ---
N8N_BASE_URL="https://tradingb.app.n8n.cloud"
N8N_API_KEY="REPLACE_ME"                                         # secret (workflow:read)

# --- Encryption: gpg recipient to encrypt every artifact to (public key id/email) ---
# The matching PRIVATE key + passphrase stay in the operator vault (needed only to RESTORE).
# This MUST match the key dr_setup_key_and_db_backup.sh creates (UID: support@strateloq.com).
# You may instead paste the key FINGERPRINT the setup script prints (more exact than the email).
DR_GPG_RECIPIENT="support@strateloq.com"

# --- Offsite destination (the REAL Google Drive folder tree, verified 2026-10-27) ---
# The founder's verified rclone remote is `strateloqdrive:` (confirm with: rclone listremotes).
# You only need DR_BACKUP_PARENT — the five numbered folders (01..05) derive from it, and
# dr_backup_resume.sh also derives DR_DB_REMOTE from it so config never blocks on a missing folder.
# The backup parent + its five numbered folders already exist in Drive; use the EXACT names
# (note the " — " em-dash). rclone tolerates spaces/em-dashes when the value is quoted.
DR_TRANSPORT="rclone"
DR_BACKUP_PARENT="strateloqdrive:Strateloq Technologies — Backups"
DR_DB_REMOTE="$DR_BACKUP_PARENT/01 — Supabase Database"
DR_STORAGE_REMOTE="$DR_BACKUP_PARENT/02 — Supabase Storage (Images & Videos)"
DR_N8N_REMOTE="$DR_BACKUP_PARENT/03 — n8n Workflows"
DR_SOURCE_REMOTE="$DR_BACKUP_PARENT/04 — Edge Functions & Source Code"
DR_VERIFY_REMOTE="$DR_BACKUP_PARENT/05 — Backup Verification & Recovery"
# DR_REMOTE: parent under which dr_weekly_backup.sh writes a combined dated set.
DR_REMOTE="$DR_BACKUP_PARENT/weekly"
# RCLONE_BIN="rclone"            # override if rclone is not on PATH under Task Scheduler

# --- Local staging + retention (bounded storage growth) ---
DR_BACKUP_ROOT="$HOME/strateloq-backups"   # local staging + run logs live here
DR_RETAIN="8"                              # keep newest 8 verified sets (local + remote)
# Both PRIVATE Supabase Storage buckets (verified live: pulse-generated-media has objects,
# pulse-product-imports is currently empty but is included so it is covered when it fills).
DR_BUCKETS="pulse-generated-media pulse-product-imports"
